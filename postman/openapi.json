{
  "openapi": "3.0.3",
  "info": {
    "title": "Registro grupo 1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001"
    }
  ],
  "paths": {
    "/api/auth/registro": {
      "post": {
        "summary": "Registrar estudiante",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nombres",
                  "apellidos",
                  "numero_identificacion",
                  "correo_usuario",
                  "contraseña_usuario",
                  "rol"
                ],
                "properties": {
                  "nombres": {
                    "type": "string",
                    "minLength": 1
                  },
                  "apellidos": {
                    "type": "string",
                    "minLength": 1
                  },
                  "numero_identificacion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "correo_usuario": {
                    "type": "string",
                    "format": "email"
                  },
                  "contraseña_usuario": {
                    "type": "string",
                    "minLength": 8,
                    "writeOnly": true
                  },
                  "tipo_documento": { "type": "string" },
                  "telefono": { "type": "string" },
                  "direccion": { "type": "string" },
                  "fecha_nacimiento": { "type": "string", "format": "date" },
                  "acepta_terminos_condiciones": { "type": "boolean" }
                  ,"rol": { "type": "string", "example": "ESTUDIANTE" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado; devuelve datos públicos, sin contraseña"
          },
          "400": {
            "description": "Datos o JSON inválidos"
          },
          "409": {
            "description": "Correo ya registrado"
          },
          "413": {
            "description": "Cuerpo mayor de 16 KB"
          },
          "500": { "description": "Error interno" }
        }
      }
    },
    "/api/auth/registro/estudiante": {
      "post": {
        "summary": "Registrar estudiante usando una ruta específica",
        "description": "El rol se asigna como ESTUDIANTE aunque el body incluya otro valor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "nombres": "Ana",
                "apellidos": "Peña",
                "numero_identificacion": "1000000001",
                "correo_usuario": "ana@example.com",
                "contraseña_usuario": "ClaveSegura123!"
              }
            }
          }
        }
      }
    },
    "/api/auth/registro/administrador": {
      "post": {
        "summary": "Registrar administrador usando una ruta específica"
      }
    },
    "/api/auth/registro/donante": {
      "post": {
        "summary": "Registrar donante usando una ruta específica"
      }
    },
    "/api/auth/registro/tallerista": {
      "post": {
        "summary": "Registrar tallerista usando una ruta específica"
      }
    },
    "/api/auth/registro/acudiente": {
      "post": {
        "summary": "Registrar acudiente usando una ruta específica"
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Autenticar usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "correo_usuario": "ana@example.com",
                "contraseña_usuario": "ClaveSegura123!"
              }
            }
          }
        }
      }
    },
    "/api/auth/cambiar-contrasena": {
      "patch": {
        "summary": "Cambiar contraseña del usuario autenticado",
        "parameters": [
          { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string", "example": "Bearer <token>" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "contraseña_actual": "ClaveSegura123!",
                "nueva_contraseña": "NuevaClave456!"
              }
            }
          }
        }
      }
    }
  }
}
