    {
      "name": "Eliminar registros de prueba (ejecutar al final)",
      "item": [
        { "name": "Eliminar sesión", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/sesiones/{{sesionId}}" } },
        { "name": "Eliminar asignación de estado", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/estados-usuario/{{estadoUsuarioId}}" } },
        { "name": "Eliminar asignación de rol", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/roles-usuario/{{rolUsuarioId}}" } },
