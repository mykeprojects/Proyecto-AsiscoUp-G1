{
  "info": {
    "_postman_id": "2f6d69d8-68d9-4c63-b17c-9f4dc90f7a16",
    "name": "AsiscoUp - Pruebas API",
    "description": "Colección de pruebas para la API AsiscoUp. Para local use http://localhost:3000; para producción cambie baseUrl a https://proyecto-asiscoup-g1.onrender.com. Configure adminEmail y adminPassword con credenciales de un usuario ADMIN. Ejecute primero Autenticación > Iniciar sesión para guardar el JWT. Las solicitudes CRUD requieren ADMIN. Ejecute las solicitudes de creación antes de las consultas y la carpeta de eliminación. Las operaciones de escritura y eliminación modifican datos reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('La respuesta HTTP es exitosa (2xx)', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "description": "URL base local; para Render usar https://proyecto-asiscoup-g1.onrender.com"
    },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "CambiarPassword123!" },
    { "key": "token", "value": "" },
    { "key": "usuarioId", "value": "" },
    { "key": "estadoId", "value": "" },
    { "key": "rolId", "value": "" },
    { "key": "permisoId", "value": "" },
    { "key": "sesionId", "value": "" },
    { "key": "estadoUsuarioId", "value": "" },
    { "key": "rolUsuarioId", "value": "" },
    { "key": "permisoRolId", "value": "" }
  ],
  "item": [
    {
      "name": "Sistema y documentación",
      "item": [
        {
          "name": "Verificar servicio (raíz)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La API está disponible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});",
                  "pm.test('Incluye enlaces de documentación y health', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.docs).to.eql('/api-docs');",
                  "  pm.expect(body.health).to.eql('/health');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check responde correctamente', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api-docs/"
          },
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Swagger UI está disponible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('Documentación API AsiscoUp');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener especificación OpenAPI",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api-docs.json"
          },
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Especificación OpenAPI disponible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const spec = pm.response.json();",
                  "  pm.expect(spec.openapi).to.eql('3.0.3');",
                  "  pm.expect(spec.paths['/api/auth/login']).to.exist;",
                  "  pm.expect(spec.paths['/health']).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
