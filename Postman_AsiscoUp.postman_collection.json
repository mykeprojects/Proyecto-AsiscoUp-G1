              "raw": "{\n  \"token_sesion\": \"postman-session-updated-{{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/sesiones/{{sesionId}}"
          }
